{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Harbor & Pine Law",
        "blogdescription": "Personal injury and family law in Harborview (demo site)",
        "permalink_structure": "/%postname%/",
        "hp_mode": "optimized"
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "wordpress.org/themes",
        "slug": "hello-elementor"
      },
      "options": {
        "activate": false
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "elementor"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "fluentform"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "wordpress-seo"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "activateTheme",
      "themeFolderName": "harbor-pine"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; if ( function_exists( 'demo_seed' ) ) demo_seed();"
    }
  ]
}