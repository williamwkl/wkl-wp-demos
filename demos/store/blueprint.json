{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/shop/",
  "preferredVersions": { "php": "8.3", "wp": "7.1.4" },
  "features": { "networking": true },
  "steps": [
    { "step": "setSiteOptions", "options": { "blogname": "Store demo", "permalink_structure": "/%postname%/" } },
    { "step": "installPlugin", "pluginData": { "resource": "url", "url": "https://downloads.wordpress.org/plugin/woocommerce.11.2.1.zip" }, "options": { "activate": true } },
    { "step": "installPlugin", "pluginData": { "resource": "url", "url": "https://downloads.wordpress.org/plugin/wordpress-seo.28.8.zip" }, "options": { "activate": true } },
    { "step": "activateTheme", "themeFolderName": "store" },
    { "step": "runPHP", "code": "<?php require '/wordpress/wp-load.php'; demo_seed();" }
  ]
}
