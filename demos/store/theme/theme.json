{
  "version": 3,
  "settings": {
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#1F1813"
        },
        {
          "slug": "roast",
          "name": "Roast",
          "color": "#3A2A20"
        },
        {
          "slug": "cherry",
          "name": "Cherry",
          "color": "#8E2F3F"
        },
        {
          "slug": "cherry-deep",
          "name": "Cherry deep",
          "color": "#75242F"
        },
        {
          "slug": "leaf",
          "name": "Leaf",
          "color": "#3B5A3E"
        },
        {
          "slug": "cream",
          "name": "Cream",
          "color": "#F7F1E6"
        },
        {
          "slug": "cream-2",
          "name": "Cream 2",
          "color": "#EDE4D4"
        },
        {
          "slug": "white",
          "name": "Warm white",
          "color": "#FFFCF7"
        },
        {
          "slug": "mute",
          "name": "Mute",
          "color": "#6A5F55"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Instrument Serif",
          "fontFamily": "\"Instrument Serif\", \"Iowan Old Style\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Instrument Serif",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/instrument-serif.woff2"
              ]
            },
            {
              "fontFamily": "Instrument Serif",
              "fontWeight": "400",
              "fontStyle": "italic",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/instrument-serif-italic.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "System sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "body",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.0625rem"
          }
        },
        {
          "slug": "lead",
          "size": "1.25rem",
          "fluid": {
            "min": "1.125rem",
            "max": "1.25rem"
          }
        },
        {
          "slug": "h3",
          "size": "1.625rem",
          "fluid": {
            "min": "1.375rem",
            "max": "1.625rem"
          }
        },
        {
          "slug": "h2",
          "size": "2.875rem",
          "fluid": {
            "min": "2rem",
            "max": "2.875rem"
          }
        },
        {
          "slug": "display",
          "size": "5rem",
          "fluid": {
            "min": "2.75rem",
            "max": "5rem"
          }
        }
      ],
      "defaultFontSizes": false
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1200px"
    },
    "useRootPaddingAwareAlignments": false
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--cream)",
      "text": "var(--wp--preset--color--ink)"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.05",
          "letterSpacing": "-0.01em"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--cherry)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--cherry)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": {
          "radius": "10px"
        },
        "shadow": "3px 3px 0 var(--wp--preset--color--ink)",
        "spacing": {
          "padding": {
            "top": "12px",
            "bottom": "12px",
            "left": "22px",
            "right": "22px"
          }
        },
        "typography": {
          "fontWeight": "600"
        }
      }
    },
    "blocks": {
      "woocommerce/product-price": {
        "typography": {
          "fontWeight": "600"
        }
      },
      "woocommerce/mini-cart": {
        "color": {
          "text": "var(--wp--preset--color--ink)"
        }
      }
    },
    "spacing": {
      "blockGap": "0",
      "padding": {
        "top": "0",
        "right": "0",
        "bottom": "0",
        "left": "0"
      }
    }
  },
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "templateParts": [
    {
      "name": "header",
      "area": "header",
      "title": "Header"
    },
    {
      "name": "footer",
      "area": "footer",
      "title": "Footer"
    }
  ]
}