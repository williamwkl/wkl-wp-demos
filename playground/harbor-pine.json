{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/wp-admin/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Harbor & Pine Law",
        "blogdescription": "Personal injury and family law in Harborview (demo site)",
        "permalink_structure": "/%postname%/",
        "hp_mode": "optimized"
      }
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/themes/harbor-pine"
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/themes/harbor-pine/assets"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/themes/harbor-pine/assets/favicon.svg",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/williamwkl/wkl-wp-demos/main/demos/harbor-pine/theme/assets/favicon.svg"
      }
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/themes/harbor-pine/assets/fonts"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/themes/harbor-pine/assets/fonts/newsreader-italic.woff2",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/williamwkl/wkl-wp-demos/main/demos/harbor-pine/theme/assets/fonts/newsreader-italic.woff2"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/themes/harbor-pine/assets/fonts/newsreader-var.woff2",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/williamwkl/wkl-wp-demos/main/demos/harbor-pine/theme/assets/fonts/newsreader-var.woff2"
      }
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/themes/harbor-pine/assets/img"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/themes/harbor-pine/assets/img/desk-1200.webp",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/williamwkl/wkl-wp-demos/main/demos/harbor-pine/theme/assets/img/desk-1200.webp"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/themes/harbor-pine/assets/img/pines-1200.webp",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/williamwkl/wkl-wp-demos/main/demos/harbor-pine/theme/assets/img/pines-1200.webp"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/themes/harbor-pine/assets/img/ridge-1200.webp",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/williamwkl/wkl-wp-demos/main/demos/harbor-pine/theme/assets/img/ridge-1200.webp"
      }
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/themes/harbor-pine/assets/js"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/themes/harbor-pine/assets/js/site.js",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/williamwkl/wkl-wp-demos/main/demos/harbor-pine/theme/assets/js/site.js"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/themes/harbor-pine/footer.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/williamwkl/wkl-wp-demos/main/demos/harbor-pine/theme/footer.php"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/themes/harbor-pine/functions.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/williamwkl/wkl-wp-demos/main/demos/harbor-pine/theme/functions.php"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/themes/harbor-pine/header.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/williamwkl/wkl-wp-demos/main/demos/harbor-pine/theme/header.php"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/themes/harbor-pine/style.css",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/williamwkl/wkl-wp-demos/main/demos/harbor-pine/theme/style.css"
      }
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/mu-plugins"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/demo-clean.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/williamwkl/wkl-wp-demos/main/demos/harbor-pine/mu-plugins/demo-clean.php"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/demo-schema.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/williamwkl/wkl-wp-demos/main/demos/harbor-pine/mu-plugins/demo-schema.php"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/demo-seed.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/williamwkl/wkl-wp-demos/main/demos/harbor-pine/mu-plugins/demo-seed.php"
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "wordpress.org/themes",
        "slug": "hello-elementor"
      },
      "options": {
        "activate": false
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "elementor"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "fluentform"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "wordpress-seo"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "activateTheme",
      "themeFolderName": "harbor-pine"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; if ( function_exists( 'demo_seed' ) ) demo_seed();"
    },
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    }
  ]
}
