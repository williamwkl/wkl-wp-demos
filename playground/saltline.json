    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "wordpress-seo"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "contact-form-7"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "activateTheme",
      "themeFolderName": "saltline"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; demo_seed();"
    },
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    }
